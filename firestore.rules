rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function familyDoc() { return /databases/$(database)/documents/app/family; }
    function isParent() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(familyDoc())
        && request.auth.token.email.lower() in get(familyDoc()).data.parentEmails;
    }
    function deviceDoc() { return /databases/$(database)/documents/devices/$(request.auth.uid); }
    function isDevice() { return signedIn() && exists(deviceDoc()); }
    function isKid(kidId) {
      return isDevice() && get(deviceDoc()).data.role == 'kid' && get(deviceDoc()).data.kidId == kidId;
    }
    function canRead() { return isParent() || isDevice(); }

    // Parent list, written only by the setupFamily function.
    match /app/family { allow read: if isParent(); allow write: if false; }

    // Kids, chores, rates, interest settings.
    match /app/config { allow read: if canRead(); allow write: if isParent(); }

    // Money balances and stats: only parents change them.
    match /bank/{kidId} { allow read: if canRead(); allow write: if isParent(); }

    // A kid's own choices: creature, cosmetics, savings goals, interest destination, daily checklist.
    // Creatures and cosmetics beyond the starters must be unlocked (xp/{kidId}.unlocked, written by functions).
    match /prefs/{kidId} {
      allow read: if canRead();
      allow write: if isParent() || (isKid(kidId) && okCreature(kidId) && okEquipped(kidId));
    }
    function unlockedFor(kidId) {
      let x = /databases/$(database)/documents/xp/$(kidId);
      return exists(x) ? get(x).data.get('unlocked', []) : [];
    }
    function maxLevelOf(kidId) {
      let x = /databases/$(database)/documents/xp/$(kidId);
      return exists(x) ? get(x).data.get('maxLevel', 1) : 1;
    }
    // Level each creature unlocks at. Must match CREATURES in public/game.js (a unit test checks).
    function creatureLevels() {
      return {'dragon': 1, 'fox': 1, 'frog': 1, 'dino': 1, 'unicorn': 1, 'octopus': 1, 'shark': 1, 'turtle': 1,
        'owl': 1, 'bee': 1, 'tiger': 1, 'penguin': 1, 'hedgehog': 2, 'sloth': 3, 'wolf': 4, 'cat': 5, 'lion': 6,
        'panda': 7, 'flamingo': 9, 'whale': 11, 'eagle': 13, 'robot': 14, 'invader': 16, 'wizard': 18,
        'elder': 20, 'hero': 25, 'peacock': 30};
    }
    function okCreature(kidId) {
      let c = request.resource.data.get('creature', null);
      return c == null
        || (c in creatureLevels() && (creatureLevels()[c] == 1 || creatureLevels()[c] <= maxLevelOf(kidId)));
    }
    function okSlot(kidId, e, slot, prefix) {
      let v = e.get(slot, null);
      return v == null || v == '' || (prefix + v) in unlockedFor(kidId);
    }
    function okEquipped(kidId) {
      let e = request.resource.data.get('equipped', {});
      return e.keys().hasOnly(['hat', 'theme', 'trail', 'confetti', 'title'])
        && okSlot(kidId, e, 'hat', 'h:') && okSlot(kidId, e, 'theme', 't:') && okSlot(kidId, e, 'trail', 'r:')
        && okSlot(kidId, e, 'confetti', 'f:') && okSlot(kidId, e, 'title', 'ti:');
    }

    // XP, levels, unlocks, and battles: written only by Cloud Functions.
    match /xp/{personId} {
      allow read: if canRead();
      allow write: if false;
      match /events/{eventId} { allow read: if isParent(); allow write: if false; }
    }
    match /battles/{battleId} { allow read: if canRead(); allow write: if false; }

    // Reward claims: created by the claimReward function; parents approve, mark given, or remove them.
    match /claims/{claimId} { allow read: if canRead(); allow update, delete: if isParent(); allow create: if false; }

    // Parent bounties: parents create and edit them; kids claim and parents award through functions.
    match /bounties/{bountyId} { allow read: if canRead(); allow write: if isParent(); }

    // Family goal and other shared game settings parents change often.
    match /app/game { allow read: if canRead(); allow write: if isParent(); }

    // Each parent's push token, for reward claims and battles that need a parent.
    match /parentTokens/{uid} { allow read: if isParent(); allow write: if isParent() && request.auth.uid == uid; }

    // One doc per person per week. Chore entries are added by the completeChore function.
    // Kids may only set their goal (once), bonus destination, and how savings split between goals.
    match /weeks/{weekId} {
      allow read: if canRead();
      allow write: if isParent();
      allow create: if isKid(request.resource.data.kidId)
        && weekId == request.resource.data.week + '_' + request.resource.data.kidId
        && request.resource.data.keys().hasOnly(['kidId', 'week', 'goal', 'bonusTo', 'saveTo', 'saveSplit']);
      allow update: if isKid(resource.data.kidId)
        && resource.data.get('closed', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['goal', 'bonusTo', 'saveTo', 'saveSplit'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['goal'])
            || resource.data.get('goal', null) == null);
    }

    // Paired devices, created only by the pairDevice function.
    match /devices/{uid} {
      allow read: if isParent() || (signedIn() && request.auth.uid == uid);
      allow delete: if isParent();
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken', 'tokenAt']);
    }

    match /pairCodes/{code} { allow read, write: if isParent(); }
  }
}
